{
  "manifest_version": 3,
  "name": "User Agent Scraper",
  "version": "1.3.0",
  "description": "Scrape user agents with auto-refresh, smart duplicate removal, and auto tab management",
  "permissions": [
    "tabs",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://useragents.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://useragents.io/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "User Agent Scraper"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
